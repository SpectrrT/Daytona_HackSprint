{
  "name": "hollow-purple",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @hollow-purple/server --filter @hollow-purple/web dev",
    "build": "pnpm typecheck && pnpm --filter @hollow-purple/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @hollow-purple/server test && pnpm --filter @hollow-purple/mcp test && python3 -m unittest discover -s lab -p 'test_*.py' -v",
    "doctor": "pnpm --filter @hollow-purple/server run doctor",
    "snapshot": "pnpm --filter @hollow-purple/server snapshot",
    "smoke": "pnpm --filter @hollow-purple/server smoke",
    "software:demo": "pnpm --filter @hollow-purple/server exec node --import tsx src/scripts/run-software.ts",
    "cleanup": "pnpm --filter @hollow-purple/server cleanup",
    "ablation": "pnpm --filter @hollow-purple/server exec tsx src/scripts/local.ts ablation",
    "metrics": "pnpm --filter @hollow-purple/server exec tsx src/scripts/local.ts metrics",
    "charts": "pnpm --filter @hollow-purple/server exec tsx src/scripts/local.ts charts",
    "agents:demo": "pnpm --filter @hollow-purple/server exec node --import tsx src/scripts/run-agent-lab.ts"
  }
}
