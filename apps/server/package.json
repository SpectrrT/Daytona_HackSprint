{
  "name": "@hollow-purple/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test src/**/*.test.ts",
    "doctor": "node --import tsx src/scripts/doctor.ts",
    "snapshot": "node --import tsx src/scripts/build-snapshot.ts",
    "smoke": "node --import tsx src/scripts/smoke.ts",
    "cleanup": "node --import tsx src/scripts/cleanup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@daytona/sdk": "^0.224.1",
    "@hollow-purple/shared": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "hono": "^4.13.13",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
