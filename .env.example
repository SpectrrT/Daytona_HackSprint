# Live runs use actual model jobs and Daytona Verilator execution.
PORT=8787
MAX_CONCURRENT_RUNS=2

# Real hardware execution: one Daytona sandbox per candidate.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=
# Start with daytona-small (bootstraps Verilator), or build a fast snapshot:
# pnpm snapshot, then set PROD_SNAPSHOT=hollow-purple-hardware-v1
PROD_SNAPSHOT=daytona-small
SANDBOX_AUTO_STOP_MINUTES=30
KEEP_FORKS=false

# Anchor Browser drives the dashboard through a public URL.
ANCHOR_API_KEY=
ANCHOR_API_URL=https://api.anchorbrowser.io
# Allow a complete recorded repair experiment; sessions close when the run ends.
ANCHOR_SESSION_MAX_MINUTES=30
ANCHOR_SESSION_IDLE_MINUTES=5
PUBLIC_DASHBOARD_URL=

# Uses the installed Codex CLI's existing sign-in. No model API key is copied.
AGENT_PROVIDER=codex-cli
CODEX_BIN=codex
AGENT_TIMEOUT_SECONDS=240
# Leave these blank to use Codex's default model.
BLUE_MODEL=
RED_MODEL=
# Optional target assistant override for the three-application agent lab.
AGENT_LAB_TARGET_MODEL=
# Optional alternative: AGENT_PROVIDER=anthropic requires a key and explicit models.
ANTHROPIC_API_KEY=
# Local Python executable for the independent verifier (default: python3).
PYTHON_BIN=python3

# Optional run-scoped graph memory. All three fields are required together.
# Lessons remain proposed until a descendant passes every acceptance check.
SURREAL_CONTEXT_URL=
SURREAL_CONTEXT_ID=
SURREAL_API_KEY=

# Optional OpenInference traces. Uses the isolated Python arize-otel bridge.
ARIZE_ENABLED=false
ARIZE_API_KEY=
ARIZE_SPACE_ID=
ARIZE_PYTHON=
# Release gate: a human approves the champion before it is released.
# Voice: ELEVENLABS_API_KEY + ELEVENLABS_AGENT_ID (create the agent with src/scripts/create-approver-agent.ts).
# Phone: all five. Neither: approval happens with dashboard buttons.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
APPROVER_PHONE_NUMBER=
APPROVE_WEBHOOK_SECRET=

# Arize AX tracing of runs, verifier verdicts and Blue / Red model calls (off when unset).
ARIZE_PROJECT_NAME=hollow-purple

# Claude on Bedrock. This file points to workshop credentials, never contains them.
# The private JSON has AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN.
BEDROCK_REGION=us-west-2
BEDROCK_CREDENTIALS_FILE=
AGENT_MAX_TOKENS=16384
MEMORY_MODE=graph
