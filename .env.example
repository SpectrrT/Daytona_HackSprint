# Copy to .env and fill in. Never commit .env.
# Everyone: get your keys working in the first 15 minutes (`make check-keys`).

# --- Arena backend: "fake" runs everything locally with a rules oracle (no sandboxes, no money).
#     "daytona" uses real forked sandboxes. Numbers from "fake" never go on a slide.
ARENA_BACKEND=fake

# --- Daytona (Tensae) — https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
# Name of the prod sandbox that worlds are forked from (scripts/build_snapshot.py creates it)
PROD_SANDBOX_NAME=antibody-prod
# Snapshot used for the grader sandbox (plain Python image is fine)
GRADER_IMAGE=python:3.11-slim

# --- Claude on Amazon Bedrock (Ryan) — AWS lab account from the hackathon
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
CLAUDE_MODEL=anthropic.claude-opus-5-5
# Re-sent once on a refusal (stop_reason == "refusal")
CLAUDE_FALLBACK_MODEL=anthropic.claude-opus-4-8
# low | medium | high — Opus 5.5 defaults to medium; lower it if a generation runs over 2 minutes
CLAUDE_EFFORT=medium
# 1 = cache every model response on disk (runs/llm_cache) so a recorded run replays identically
LLM_CACHE=1

# --- SurrealDB (Ryan) — local: `make surreal`, or SurrealDB Cloud credentials
# memory = in-process (no database needed); surreal = the real attack tree
MEMORY_BACKEND=memory
SURREAL_URL=ws://localhost:8001/rpc
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=antibody
SURREAL_DB=arena

# --- Arize AX (Ryan) — Space settings → API keys
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=antibody

# --- ElevenLabs approver call (Donald) — Agents platform + a Twilio number imported into ElevenLabs
# elevenlabs = real call; fake-approve / fake-decline = no call (dev, tests, graduation dry run)
APPROVER=fake-approve
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
APPROVER_PHONE_NUMBER=
# Shared secret the ElevenLabs agent's webhook tool sends in the X-Approve-Secret header
APPROVE_WEBHOOK_SECRET=change-me
