{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "arena",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": [
        "arena.app:app",
        "--reload",
        "--port",
        "8000"
      ],
      "port": 8000
    }
  ]
}
